{
  "appId": "ru.allyourclients.app",
  "appName": "Все клиенты здесь",
  "webDir": "www",
  "server": {
    "url": "https://allyourclients.ru",
    "cleartext": false,
    "allowNavigation": [
      "allyourclients.ru",
      "*.allyourclients.ru",
      "oauth.yandex.ru",
      "id.vk.com",
      "oauth.vk.com",
      "id.vk.ru",
      "telegram.org",
      "oauth.telegram.org"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FFFFFF"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FFFFFF"
    }
  }
}
